# ---------------------------------------------------------------------------
# OlnkTR environment configuration
#
# Copy to `.env` (or run `pnpm setup:env`, which generates random secrets).
# Every variable is validated at start-up by packages/config/src/env.ts.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NODE_ENV=development
# Deployment environment: development | test | staging | production.
# Production safety checks (https, no dev billing, real secrets) apply to "production",
# which is the default whenever NODE_ENV=production.
APP_ENV=development
APP_URL=http://localhost:3100
DEFAULT_LOCALE=en
LOG_LEVEL=info
# Trust X-Forwarded-For / X-Real-IP (enable only behind a reverse proxy you control)
TRUST_PROXY=false
# Header carrying the real client IP, overwritten by your proxy (e.g. x-real-ip, cf-connecting-ip)
CLIENT_IP_HEADER=x-forwarded-for

# --- PostgreSQL ------------------------------------------------------------
# Application role: DML only. Migration role: owns the schema (DDL).
DATABASE_URL=postgres://olnktr_app:olnktr_app_dev_password@localhost:54329/olnktr
DATABASE_MIGRATION_URL=postgres://olnktr_migrator:olnktr_migrator_dev_password@localhost:54329/olnktr
DATABASE_POOL_MAX=10
# Isolated database used by integration tests (must end with `_test`)
TEST_DATABASE_URL=postgres://olnktr_app:olnktr_app_dev_password@localhost:54329/olnktr_test
TEST_DATABASE_MIGRATION_URL=postgres://olnktr_migrator:olnktr_migrator_dev_password@localhost:54329/olnktr_test

# Docker Compose bootstrap values (used by docker-compose.yml)
POSTGRES_PORT=54329
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_password
POSTGRES_APP_PASSWORD=olnktr_app_dev_password
POSTGRES_MIGRATOR_PASSWORD=olnktr_migrator_dev_password

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:63799/0
REDIS_KEY_PREFIX=olnktr
# Integration tests use a separate logical database
TEST_REDIS_URL=redis://localhost:63799/15
REDIS_PORT=63799

# --- Authentication (Better Auth) ------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Rate limiting of sign-in/sign-up/reset endpoints (always on in production)
AUTH_RATE_LIMIT_ENABLED=true
# Extra trusted origins for auth requests (comma separated). APP_URL is always trusted.
AUTH_TRUSTED_ORIGINS=
# OAuth providers are optional; leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ACCOUNT_DELETION_GRACE_DAYS=30

# --- Email (SMTP) ----------------------------------------------------------
# Local development uses Mailpit (UI: http://localhost:18025)
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="OlnkTR <no-reply@olnk.tr>"
MAILPIT_UI_PORT=18025
MAILPIT_SMTP_PORT=11025

# --- Object storage (S3 compatible; MinIO locally) -------------------------
# S3_ENDPOINT is used server-side; S3_PUBLIC_ENDPOINT must be reachable by browsers
# (presigned upload/download URLs are signed for this host).
S3_ENDPOINT=http://localhost:19000
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=olnktr-media
S3_ACCESS_KEY_ID=olnktr-app
S3_SECRET_ACCESS_KEY=olnktr-app-dev-secret
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_UPLOAD_BYTES=5242880
MINIO_ROOT_USER=olnktr-minio-admin
MINIO_ROOT_PASSWORD=olnktr-minio-dev-password
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# --- Billing ---------------------------------------------------------------
# Enabled payment providers (comma separated): dev, stripe, paytr
# `dev` is a local test adapter that drives the real webhook pipeline with
# HMAC-signed events. It is rejected when NODE_ENV=production.
BILLING_PROVIDERS=dev
BILLING_DEFAULT_PROVIDER=dev
BILLING_GRACE_PERIOD_DAYS=7
DEV_BILLING_WEBHOOK_SECRET=replace-with-random-dev-webhook-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true

# --- Analytics -------------------------------------------------------------
ANALYTICS_RAW_RETENTION_DAYS=90
ANALYTICS_AGGREGATE_RETENTION_DAYS=730
# Request header carrying the visitor's ISO country code (set by your CDN/proxy)
ANALYTICS_COUNTRY_HEADER=cf-ipcountry

# --- Observability ---------------------------------------------------------
# Sentry-compatible DSN (Sentry, GlitchTip, ...). Empty = disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# OTLP/HTTP endpoint, e.g. http://localhost:4318. Empty = tracing disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=olnktr

# --- Worker ----------------------------------------------------------------
WORKER_HEALTH_PORT=3101
WEB_PORT=3100
