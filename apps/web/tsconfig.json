{
  "extends": "@olnktr/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": { "~/*": ["./src/*"] },
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "src",
    "e2e",
    "messages",
    "*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
