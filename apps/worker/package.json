{
  "name": "@olnktr/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@olnktr/analytics": "workspace:*",
    "@olnktr/billing": "workspace:*",
    "@olnktr/config": "workspace:*",
    "@olnktr/core": "workspace:*",
    "@olnktr/db": "workspace:*",
    "@olnktr/email": "workspace:*",
    "@olnktr/jobs": "workspace:*",
    "@olnktr/observability": "workspace:*",
    "@olnktr/storage": "workspace:*",
    "@olnktr/types": "workspace:*",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
